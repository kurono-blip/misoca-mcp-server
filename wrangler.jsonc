{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "misoca-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "MyMCP"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MyMCP"]
    }
  ],

  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "67b56ce14adb4e19982c0ffcf678bdc5"
    }
  ]
}
